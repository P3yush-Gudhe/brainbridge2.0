{
  "name": "studymate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "typecheck": "frontend/node_modules/.bin/tsc -p tsconfig.server.json --noEmit && frontend/node_modules/.bin/tsc -p frontend/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "start": "NODE_ENV=production node server.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^2.0.0"
  }
}
