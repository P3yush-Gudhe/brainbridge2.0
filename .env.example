# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS in production
CORS_ORIGIN=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# PostgreSQL / Cloud SQL
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Firebase Admin SDK (optional locally when using Application Default Credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Code Playground Sandbox (never executes on host directly)
# Driver: "api" (external runner API) or "docker" (requires Docker socket)
CODE_RUNNER_DRIVER=
CODE_RUNNER_API_URL=
CODE_RUNNER_API_KEY=
