{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types", "./frontend/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend"
  ]
}
